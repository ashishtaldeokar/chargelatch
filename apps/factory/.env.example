# Hosted Keycloak (same realm and clients, reachable from phones): https://auth.ashishtaldeokar.in
# The API, both web apps and the mobile app must all use the SAME Keycloak, or tokens are rejected.
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=chargelatch
VITE_KEYCLOAK_CLIENT_ID=chargelatch-factory
