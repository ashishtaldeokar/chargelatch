menu "chargelatch SDM energy meter"

    # The meter model and serial settings are DEVICE CONFIGURATION, written into the fctry
    # partition by the factory app (see device_identity). The values here are only the defaults
    # for a board without factory data (flashed with idf.py).

    config SDM_METER_DEFAULT_MODEL
        string "Default meter model (no factory data)"
        default "SDM120"
        help
            Name of an sdm_model_t in components/sdm_meter/sdm_registers.c (see meters.json).

    config SDM_METER_DEFAULT_SLAVE_ADDRESS
        int "Default Modbus slave address (no factory data)"
        default 1
        range 1 247

    config SDM_METER_DEFAULT_BAUD_RATE
        int "Default baud rate (no factory data)"
        default 2400
        help
            SDM120 factory default is 2400; SDM630 is 9600.

    config SDM_METER_UART_NUM
        int "UART port"
        default 2
        range 1 2
        help
            UART0 is the console. The devkit's "RX2/TX2" pins are UART2.

    config SDM_METER_TX_GPIO
        int "TX GPIO (to the transceiver's DI)"
        default 17
        help
            "TX2" on ESP32 devkits. Note GPIO16/17 are taken by PSRAM on WROVER modules.

    config SDM_METER_RX_GPIO
        int "RX GPIO (from the transceiver's RO)"
        default 16
        help
            "RX2" on ESP32 devkits.

    config SDM_METER_DE_GPIO
        int "DE / RE GPIO (RS-485 direction)"
        default 4
        help
            Drives the transceiver's DE and /RE pins, tied together (MAX485-style modules): high
            while transmitting, low while listening. The UART hardware toggles it per frame.
            Set to -1 for a transceiver with automatic direction control.

endmenu
