PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/chargelatch
# Hosted Keycloak (same realm and clients, reachable from phones): https://auth.ashishtaldeokar.in
# The API, both web apps and the mobile app must all use the SAME Keycloak, or tokens are rejected.
# Hosted: KEYCLOAK_ISSUER=https://auth.ashishtaldeokar.in/realms/chargelatch
KEYCLOAK_ISSUER=http://localhost:8080/realms/chargelatch
KEYCLOAK_AUDIENCE=chargelatch-api
# The broker the DEVICES use (apps/firmware/sdkconfig.defaults), so real devices show up in dev.
# Use mqtt://localhost:1883 for the EMQX from `pnpm services:up` instead.
MQTT_URL=mqtt://ashishtaldeokar.ddns.net:1883
