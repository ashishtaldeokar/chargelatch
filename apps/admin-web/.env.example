# Hosted Keycloak (same realm and clients, reachable from phones): https://auth.ashishtaldeokar.in
# The API, both web apps and the mobile app must all use the SAME Keycloak, or tokens are rejected.
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=chargelatch
VITE_KEYCLOAK_CLIENT_ID=chargelatch-admin-web
# MQTT over WebSocket, for live device data. Must be the SAME broker the API uses (MQTT_URL in
# apps/api/.env). Real devices: ws://ashishtaldeokar.ddns.net:8083/mqtt. Needs wss:// once the
# portal is served over https.
VITE_MQTT_WS_URL=ws://localhost:8083/mqtt
