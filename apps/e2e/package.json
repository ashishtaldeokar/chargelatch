{
  "name": "@chargelatch/e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:e2e": "bun test --timeout 300000 ./src/",
    "test:e2e:browser": "bun run src/run.ts",
