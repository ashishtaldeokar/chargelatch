{
  "name": "chargelatch",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel --if-present run dev",
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test:unit": "pnpm -r --if-present run test:unit",
    "test:e2e": "pnpm --filter @chargelatch/e2e run test:e2e",
    "test:e2e:browser": "pnpm --filter @chargelatch/e2e run test:e2e:browser",
    "services:up": "docker compose up -d --build",
    "services:down": "docker compose down",
    "keycloak:export": "bun infra/keycloak/export-realm.ts",
    "db:generate": "pnpm --filter @chargelatch/db run db:generate",
    "db:migrate": "pnpm --filter @chargelatch/db run db:migrate",
    "db:seed": "pnpm --filter @chargelatch/db run db:seed",
    "db:reset": "pnpm --filter @chargelatch/db run db:reset",
    "admin-mobile": "pnpm --filter @chargelatch/admin-mobile run start",
    "firmware:build": "pnpm --filter @chargelatch/firmware run firmware:build",
    "firmware:flash": "pnpm --filter @chargelatch/firmware run firmware:flash",
    "firmware:bundle": "pnpm --filter @chargelatch/factory run firmware:bundle"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.1.1",
      "onFail": "download"
    },
    "runtime": {
      "name": "bun",
      "version": "^1.3.10",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
