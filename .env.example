# Local dev defaults for `pnpm services:up`. Bun loads .env itself (no dotenv), from the
# directory a process starts in, so copy the values you need into apps/<app>/.env.

# Postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/chargelatch

# Redis (cache only, no persistence)
REDIS_URL=redis://localhost:6379

# MQTT broker the API bridges to. Real devices use mqtt://ashishtaldeokar.ddns.net:1883
# (apps/firmware/sdkconfig.defaults); this is the dev/e2e EMQX from `pnpm services:up`.
MQTT_URL=mqtt://localhost:1883

# Keycloak
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=chargelatch
KEYCLOAK_ISSUER=http://localhost:8080/realms/chargelatch
KEYCLOAK_AUDIENCE=chargelatch-api
KEYCLOAK_CLIENT_ID=chargelatch-api
KEYCLOAK_CLIENT_SECRET=dev-secret
